# ============================================
# RAILWAY.APP DEPLOYMENT DOCKERFILE
# Production-optimized backend for Railway deployment
# Build context: backend/ directory (Root Directory = backend)
# ============================================
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from parent directory
COPY ../requirements.txt /app/requirements.txt

# Install Python packages
RUN pip install --no-cache-dir -r requirements.txt

# Copy scripts directory from parent
COPY ../scripts /app/scripts/

# Copy backend code from current directory
COPY . /app/backend/

# Set working directory to backend
WORKDIR /app/backend

# Set permissions for startup script
RUN chmod +x /app/backend/startup.sh

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# Expose port (Railway will set PORT env var dynamically)
# Note: Railway assigns ports dynamically, EXPOSE is just documentation

# Health check - disabled for Railway (Railway has its own healthcheck system)
# HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
#     CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start application
CMD ["./startup.sh"]
