# Stirling Chat MVP - Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to Git!

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection details (Docker container)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=stirling_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Note: Using port 5433 to avoid conflict with local PostgreSQL on 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stirling_chat

# ============================================
# API KEYS (Get these from respective platforms)
# ============================================

# FireCrawl API Key
# Get from: https://firecrawl.dev
# Used for: Web scraping (1,206 URLs)
# Cost: $20 for Starter plan
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Used for: Embeddings (text-embedding-3-small)
# Cost: ~$0.07 for all embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
# Get from: https://console.anthropic.com/
# Used for: LLM responses (Claude Sonnet 4 — default for this project)
# Cost: higher than Haiku; see tutorials/stirling_chat_guide/06_LLM_STRATEGY.md
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment (development, production)
ENVIRONMENT=development

# API Host and Port
API_HOST=localhost
API_PORT=8001

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# EMBEDDING CONFIGURATION
# ============================================

# Embedding model to use
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensions
EMBEDDING_DIMENSIONS=1536

# ============================================
# CHUNKING CONFIGURATION
# ============================================

# Chunk size in tokens
CHUNK_SIZE=800

# Chunk overlap in tokens
CHUNK_OVERLAP=200

# ============================================
# RAG CONFIGURATION
# ============================================

# LLM model (Anthropic). Must match scripts/enhanced_rag.py default.
LLM_MODEL=claude-sonnet-4-20250514

# Number of chunks to retrieve for context
TOP_K_CHUNKS=5

# Maximum tokens for LLM response
MAX_RESPONSE_TOKENS=1024

# Temperature for LLM (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7
